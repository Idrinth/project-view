# Build output - generated by bin/build.php
/public/*
!/public/.gitkeep

# Local SQLite database - created by bin/migrate.php. Includes the
# -journal, -wal and -shm sidecar files SQLite writes alongside it.
/config/*.sqlite
/config/*.sqlite-*

# Uploaded comment attachments (images, video, audio). Created on
# demand by the API when a comment is posted with media.
/config/uploads/
